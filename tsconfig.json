{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals",
      "node"
    ]
  },
  "files": [],
  "references": [
    {
      "path": "./apps/nest-microservices/tsconfig.app.json"
    },
    {
      "path": "./apps/api-gateway/tsconfig.app.json"
    },
    {
      "path": "./apps/user-service/tsconfig.app.json"
    },
    {
      "path": "./apps/product-service/tsconfig.app.json"
    },
    {
      "path": "./apps/order-service/tsconfig.app.json"
    }
  ]
}